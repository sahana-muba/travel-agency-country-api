<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
      http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
      http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
      http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <configuration-properties file="config.properties"/>

    <!-- HTTP Listener Configuration -->
    <http:listener-config
        name="HTTP_Listener_config"
        doc:name="HTTP Listener config">
        <http:listener-connection
            host="0.0.0.0"
            port="${http.port}"/>
    </http:listener-config>

    <!-- REST Countries HTTP Request Configuration -->
    <http:request-config
        name="HTTP_Request_configuration"
        doc:name="REST Countries Request Configuration">
        <http:request-connection
            protocol="HTTPS"
            host="api.restcountries.com"
            port="443"/>
    </http:request-config>

    <!-- Country System API Flow -->
    <flow name="travel-country-system-apiFlow">

        <!-- Receive country name -->
        <http:listener
            doc:name="Country API Listener"
            config-ref="HTTP_Listener_config"
            path="/countries/{country}"/>

        <!-- Store requested country -->
        <set-variable
            variableName="requestedCountry"
            value="#[attributes.uriParams.country]"
            doc:name="Store Requested Country"/>

        <!-- Log incoming country -->
        <logger
            level="INFO"
            doc:name="Log Requested Country"
            message="#['Incoming country: ' ++ vars.requestedCountry]"/>

        <!-- Log exact external API request path -->
        <logger
            level="INFO"
            doc:name="Log Country Request URL"
            message="#['Calling REST Countries URL: /countries/v5/names.common/' ++ vars.requestedCountry]"/>

        <!-- Call REST Countries API -->
        <http:request
            method="GET"
            doc:name="Get Country Details"
            config-ref="HTTP_Request_configuration"
            path="#['/countries/v5/names.common/' ++ vars.requestedCountry]">
            <http:headers><![CDATA[#[{
                Authorization: "Bearer " ++ p('restcountries.api.key')
            }]]]></http:headers>
        </http:request>

        <!-- Log external API response -->
        <logger
            level="INFO"
            doc:name="Log External Country Response"
            message="Country API: external response received"/>

        <!-- Transform Country Response -->
        <ee:transform doc:name="Transform Country Response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
var country = payload.data.objects[0]
---
{
    requestedCountryReceived: vars.requestedCountry,
    countryName: country.names.common,
    capitalCity: country.capitals[0].name,
    region: country.region,
    population: country.population,
    officialCurrency: country.currencies[0].name,
    currencyCode: country.currencies[0].code,
    flagUrl: country.flag.url_png
}
]]></ee:set-payload>
            </ee:message>
        </ee:transform>

        <!-- Log final response -->
        <logger
            level="INFO"
            doc:name="Log Country Response"
            message="#[payload]"/>

    </flow>

</mule>
